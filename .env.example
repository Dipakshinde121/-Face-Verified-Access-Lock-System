# ==============================================================================
# Environment Configuration Template (.env.example)
# Lab Face-Verified Access Lock System
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit .env to version control):
#    cp .env.example .env
# 2. Fill in your environment-specific credentials below.
# 3. Values set here override config.json at runtime for strict secrets hygiene.
# ==============================================================================

# Server Network Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_URL=https://127.0.0.1:8000

# Continuous Verification Timers & Thresholds
VERIFICATION_INTERVAL=30
GRACE_PERIOD_MISSED_CHECKS=2
FACE_MATCH_TOLERANCE=0.60
MAX_PAUSE_DURATION_SECONDS=300

# Real-Time Incident Alerting Webhook (Discord/Slack/Teams)
# Keep empty to disable outbound alerting
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Security Notice:
# - Master encryption keys for Fernet AES-128 are NEVER stored in this file.
#   They are dynamically retrieved from the host Operating System Keyring
#   (Windows Credential Manager / macOS Keychain / Secret Service).
# - Device JWT secrets are issued dynamically during device provisioning.
